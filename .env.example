# Copy this file to a new file called .env and fill in your real values.
# The real .env is listed in .gitignore and will NOT be uploaded to GitHub.

# Neon PostgreSQL connection string (from your Neon dashboard)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# OpenWeatherMap API key (from https://openweathermap.org/api)
WEATHER_API_KEY=your_openweathermap_api_key_here

# Optional: minimum delay (in minutes) before a bike is ever suggested.
# If not set, the code defaults to 7.
BIKE_SUGGESTION_THRESHOLD_MIN=7
